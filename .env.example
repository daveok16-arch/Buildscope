# GEMINI_API_KEY: Enables the operator AI analyst (/ai-analyst, /api/project/<id>/analyst,
# `flask analyst-project`). Optional: when no provider key is set the analyst reports UNAVAILABLE
# and uses the deterministic evidence-only summary, and nothing else is affected. The analyst
# writes prose about stored evidence only; every value it produces is re-checked against that
# evidence before it is shown. GEMINI_MODEL selects the model (default gemini-2.5-flash). Never
# commit a real key. A sandbox that injects the key as `Gemini_API_Token` is also honoured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-2.5-flash"

# XAI_API_KEY: The alternative analyst provider, xAI's Grok (OpenAI-compatible API). Either
# provider works; with both keys set, Gemini is used unless AI_ANALYST_PROVIDER names one
# ("gemini" or "xai"). Grok goes through the same grounding and verification as Gemini, so the
# choice of model does not change what the analyst is allowed to claim. XAI_MODEL selects the
# model (default grok-3-mini). A sandbox that injects the key as `Grok_API_Token` is also honoured.
# XAI_API_KEY="MY_XAI_API_KEY"
# XAI_MODEL="grok-3-mini"
# AI_ANALYST_PROVIDER="gemini"   # or "xai"; only needed when both keys are present

# Firebase web configuration for Google Sign-In. The web API key is public client config, but
# it must NOT be committed. Provide the full JSON object inline (most managed hosts), or point
# FIREBASE_CONFIG_PATH at a JSON file outside the repository. See firebase-applet-config.example.json.
# FIREBASE_CONFIG_JSON='{"projectId":"...","apiKey":"...","authDomain":"...","appId":"..."}'
# FIREBASE_CONFIG_PATH="/run/secrets/firebase-applet-config.json"
# FIREBASE_PROJECT_ID: expected audience for a Firebase ID token; falls back to the projectId above.
# FIREBASE_PROJECT_ID="your-firebase-project-id"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
